# Copy this file to .env and fill in the real values from your Green API console
# (https://console.green-api.com). NEVER commit .env — it's already listed in
# the repo's .gitignore, but double-check before pushing anything from here.

GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Green API assigns a per-instance API URL — copy it from the console instead
# of assuming api.green-api.com; recent instances use sharded hosts.
GREEN_API_URL=https://api.green-api.com

PORT=3001
